DATABASE_URL=postgresql+psycopg://canopy:canopy@localhost:5433/canopy
TEST_DATABASE_URL=postgresql+psycopg://canopy:canopy@localhost:5433/canopy_test

# LLM — any OpenAI-compatible endpoint (DeepSeek, OpenAI, Anthropic, Google, local).
# A working DeepSeek key ships in app/core/config.py defaults for the demo, so a .env is only
# needed to override it. deepseek-chat is the cheapest model.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
